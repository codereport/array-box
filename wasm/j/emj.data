getdepend_console=: 0&$: : (4 : 0)
if. 0 = #y do. y return. end.
old=. ''
if. 0=#PKGDATA do. init_console'' end.
ids=. 1{"1 PKGDATA
dep=. 6{"1 PKGDATA
res=. ~. <;._1 ; ',' ,each (ids e. y) # dep
whilst. -. res-:old do.
  old=. res
  res=. ~. res, <;._1 ; ',' ,each (ids e. res) # dep
end.
/:~ ~. y, res -. a:, (0=x)# {."1 ADDINS
)
REPOS=: ;:'github'
cutrepo=: 3 : 0
t=. remsep jpathsep deb y
ndx=. t i. ':'
tag=. ndx {. t
t=. (ndx+1) }. t
ndx=. t i. '@'
rep=. ndx {. t
cmt=. (ndx+1) }. t
cmt=. cmt,(0=#cmt)#'master'
tag;rep;cmt
)

if. 0 -: readpackage tag;rep;cmt do. 0 return. end.
frm=. 0 pick splitrep rep
msg=. 'installed: ',frm,' ',cmt
if. -. frm -: FOLDER do.
  msg, ' into folder: ',FOLDER
end.

␀r+␀USER␀PASS␀TYPE I␀inconsistent rules for target %s␀.PHONY␀.PRAGMA␀commands defined twice for target %s␀: allow with pragma macro_name␀invalid macro name '%s'%s␀glob error for '%s'␀^eij:+knqrsStpf:*C:*x:*␀k-S:S-k␀invalid MAKEFLAGS␀-C not allowed␀unterminated variable '%s'␀: allow with pragma empty_suffix␀empty suffix%s␀recursive macro %s␀MAKE␀%s%s%s␀.SUFFIXES:.o .c .y .l .a .sh .f
.c.o:
	$(CC) $(CFLAGS) -c $<
.f.o:
	$(FC) $(FFLAGS) -c $<
.y.o:
	$(YACC) $(YFLAGS) $<
	$(CC) $(CFLAGS) -c y.tab.c
	rm -f y.tab.c
	mv y.tab.o $@
.y.c:
	$(YACC) $(YFLAGS) $<
	mv y.tab.c $@
.l.o:
	$(LEX) $(LFLAGS) $<
	$(CC) $(CFLAGS) -c lex.yy.c
	rm -f lex.yy.c
	mv lex.yy.o $@
.l.c:
	$(LEX) $(LFLAGS) $<
	mv lex.yy.c $@
.c.a:
	$(CC) -c $(CFLAGS) $<
	$(AR) $(ARFLAGS) $@ $*.o
	rm -f $*.o
.f.a:
	$(FC) -c $(FFLAGS) $<
	$(AR) $(ARFLAGS) $@ $*.o
	rm -f $*.o
.c:
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $<
.f:
	$(FC) $(FFLAGS) $(LDFLAGS) -o $@ $<
.sh:
	cp $< $@
	chmod a+x $@
CC=c99
CFLAGS=-O1
FC=fort77
FFLAGS=-O1
YACC=yacc
YFLAGS=
LEX=lex
LFLAGS=
AR=ar
ARFLAGS=-rv
LDFLAGS=

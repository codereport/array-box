      end.
    case. ;:'Z:' do.
      if. e=EVSYNTAX do. hdr,'fold is not running' return. end.
    case. ;:'@.' do.
      if. ism do.  NB. the errors in @. must include the selectors
        if. e=EVRANK do. if. (#@$ind) > a >.&(#@$) w do.

select. type
case. 'jbreak' do.
  r=. '#!/bin/sh',LF,'"',c,'.command" ',LIB
case.'jc' do.
  r=. new_launch rplc '<COM>';COM;'<C>';(hostpathsep jpath '~bin/jconsole');'<A>';LIB
case. 'jhs' do.
  r=. new_launch rplc '<COM>';COM;'<C>';(hostpathsep jpath '~bin/jconsole');'<A>';LIB,A
case. 'jqt' do.
  r=. '#!/bin/sh',LF,'"',c,'.command" ',LIB
end.
